# Copy this file to .env and fill in the key. .env is never committed.

# Google Gemini API key for the Council's LLM explanation (https://aistudio.google.com/apikey).
# Leave empty to use the built-in rule-based explanation.
GEMINI_API_KEY=

# Optional: override the Gemini model
# GEMINI_MODEL=gemini-flash-lite-latest

# MongoDB connection string for the Market Agent's stock cache.
# Leave empty to cache in memory instead (lost on restart).
# Local:  mongodb://127.0.0.1:27017
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_URI=

# Optional: database name (default: the one named in the connection string)
# MONGODB_DB=portfolioDB

# Optional: backend port (default 5001)
# PORT=5001
